# Copie para .env (que está no .gitignore) e preencha só o que for usar.
# O modo offline do demo não precisa de nenhuma chave.

# Claude (modo --modo claude)
ANTHROPIC_API_KEY=
# CLAUDE_MODELO=claude-sonnet-5-5

# Gemini (modo --modo gemini) — chave gratuita em https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODELO=gemini-3.5-flash

# Servidor MCP
# LEGAL_OPS_DB=data/escritorio.db   # caminho do SQLite (criado e populado se não existir)
# LEGAL_OPS_HOJE=2026-11-24         # fixa a "data de hoje" (útil para demo e testes)
